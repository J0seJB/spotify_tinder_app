# Spotify
SPOTIFY_CLIENT_ID=tu_client_id_aqui
SPOTIFY_CLIENT_SECRET=tu_client_secret_aqui
SPOTIFY_REDIRECT_URI=http://127.0.0.1:9090/callback
SPOTIFY_USERNAME=tu_usuario_de_spotify

# Anthropic Claude, opcional para descripciones con IA
ANTHROPIC_API_KEY=tu_api_key_de_anthropic_aqui

# Last.fm, requerido para categorias dinamicas y similitud
LASTFM_API_KEY=tu_api_key_de_lastfm_aqui

# Genius, opcional para letras y analisis emocional
GENIUS_TOKEN=tu_token_genius_aqui

# Legacy: Spotify marco audio_features como deprecado/removido para muchos casos.
# Dejelo apagado salvo que sepa que su app aun tiene acceso.
SPOTIFY_ENABLE_AUDIO_FEATURES=false
